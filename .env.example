# Copy this file to .env and fill in your own values before running or deploying.

# A Postgres connection string. Works with Supabase, Neon, RDS, Render
# Postgres, or a Postgres you run yourself — this app has no
# Supabase-specific code, so any of them work the same way.
#
# From a Supabase project: Project Settings → Database → Connection string
# (choose "Session pooler" or "Transaction pooler" for most hosting
# platforms; use the direct connection string for local development).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Most hosted Postgres providers require SSL — leave this unset (defaults
# to true). Set to "false" only for a local Postgres that isn't using SSL.
# DATABASE_SSL=false

# Any long random string. Used to sign login sessions (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Port the server listens on. Most hosting platforms set this for you automatically.
PORT=3000
